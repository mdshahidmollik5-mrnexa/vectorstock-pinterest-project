* { margin: 0px; }

body { -webkit-font-smoothing: antialiased; }

table { border-collapse: collapse; border-spacing: 0px; }

table th { font-weight: inherit; }

ol, ul { list-style: none; padding: 0px; }

ol li, ul li { display: block; }

h1, h2, h3, h4, h5, h6, strong { font-size: inherit; font-weight: inherit; }

em { font-style: normal; }

mark { background-color: transparent; }

canvas, img, picture, svg, video { display: block; max-width: 100%; }

button, input, select, textarea { font: inherit; letter-spacing: inherit; }

h1, h2, h3, h4, h5, h6, p { overflow-wrap: break-word; }

abbr { text-decoration: none; }

@font-face { font-display: swap; font-family: VectorStockSans200; font-weight: 200; src: url("https://cdn.vectorstock.com/fonts/VectorStock-Sans/VectorStock-Sans-Text-200.woff2") format("woff2"); }

@font-face { font-display: swap; font-family: VectorStockSans450; font-weight: 450; src: url("https://cdn.vectorstock.com/fonts/VectorStock-Sans/VectorStock-Sans-Text-450.woff2") format("woff2"); }

@font-face { font-display: swap; font-family: VectorStockSans600; font-weight: 600; src: url("https://cdn.vectorstock.com/fonts/VectorStock-Sans/VectorStock-Sans-Text-600.woff2") format("woff2"); }

@font-face { font-display: swap; font-family: VectorStockSans800; font-weight: 800; src: url("https://cdn.vectorstock.com/fonts/VectorStock-Sans/VectorStock-Sans-Text-800.woff2") format("woff2"); }

body, html { min-height: 100%; padding: 0px; }

html.noanimate * { transition: none !important; }

body { background-color: rgb(255, 255, 255); color: rgb(0, 0, 0); font: 450 16px / 1.2 VectorStockSans450, sans-serif; letter-spacing: -0.01em; }

body.fixed { margin-right: var(--scrollbar-width); overflow: hidden; }

button, fieldset, input { background-color: transparent; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 0px; }

svg:not([role="group"]) { fill: none; max-width: inherit; pointer-events: none; stroke: rgb(0, 0, 0); stroke-linejoin: round; stroke-miterlimit: 10; stroke-width: 1.25; }

:root { --scrollbar-width: 0px; }

:where(a, button, input, select, textarea, summary, [role="button"], [tabindex]:not([tabindex="-1"])):focus-visible { outline: currentcolor solid 2px; outline-offset: 2px; }

.hidden { display: none; }

body > picture.preload { left: 0px; pointer-events: none; position: fixed; top: 0px; visibility: hidden; z-index: -1; }

body > a.linktrigger { left: -7777px; position: absolute; }

#vs-contents.expanded { min-height: 80vh; }

#vs-header-bar { background-color: rgb(0, 0, 0); min-height: 129px; }

@media (min-width: 890.01px) {
  #vs-header-bar { min-height: 89px; }
}
