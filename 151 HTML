.dropdown.dropdown--next .dd_values > div ul li[data-active="1"] { background-color: rgba(70, 39, 232, 0.05); color: rgb(70, 39, 232); }

.dropdown.dropdown--next .dd_values > div ul li[data-active="1"] .label .icon svg { stroke: rgb(70, 39, 232); }

.dropdown.dropdown--next .dd_values > div ul li[aria-selected="true"], .dropdown.dropdown--next .dd_values > div ul li[data-active="1"] .label .title { color: rgb(70, 39, 232); }

.dropdown.dropdown--next .dd_values > div ul li[aria-selected="true"] .label .icon svg { stroke: rgb(70, 39, 232); }

.dropdown.dropdown--next .dd_values > div ul li[aria-selected="true"] .label .title, .dropdown.dropdown--next .dd_values > div ul li[aria-selected="true"] .label small { color: rgb(70, 39, 232); }

.dropdown.dropdown--next .dd_values > div ul li[aria-selected="true"] svg { stroke-dashoffset: 0; }

.dropdown.dropdown--next[data-loading="1"] .dd_display .mark { display: none; }

.dropdown.dropdown--next[data-loading="1"] .dd_display .loadicon { position: absolute; right: 3px; top: 5px; }

.dropdown.dropdown--next[data-loading="1"] .dd_display .loadicon svg path, .dropdown.dropdown--next[data-loading="1"] .dd_display .loadicon svg polygon { color: rgb(42, 42, 46); stroke: rgb(42, 42, 46); stroke-width: 2; }

