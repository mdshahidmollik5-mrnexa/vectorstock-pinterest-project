@charset "utf-8";

nav[aria-label="Breadcrumbs"] ol { user-select: none; }

nav[aria-label="Breadcrumbs"] ol li { transition-duration: 0.15s; transition-property: color, text-decoration-color, opacity; transition-timing-function: ease-out; }

nav[aria-label="Breadcrumbs"] ol li[data-state="set"]:active, nav[aria-label="Breadcrumbs"] ol li[data-type="link"] span:active { opacity: 0.25; }

nav[aria-label="Breadcrumbs"] ol[aria-disabled="true"] { pointer-events: none; }

.image-deck .deck-grid > .noresults .module p a { transition: opacity 0.15s ease-out; }

.image-deck .deck-grid > .noresults .module p a:active { opacity: 0.25; }

#vs-page > .loadbar { background-color: rgb(255, 255, 255); display: block; left: 0px; pointer-events: none; position: fixed; top: 0px; width: 100%; z-index: 999; }

#vs-page > .loadbar > div { background-color: rgb(70, 39, 232); height: 2px; transition: width 0.5s cubic-bezier(0.215, 0.61, 0.355, 1); }

#vs-page > .loadbar[data-state="requesting"] > div { transition-duration: 1s; }

#vs-page > .loadbar[data-state="waiting"] > div { transition-duration: 5s; }

#vs-page > .loadbar[data-state="downloading"] > div { transition-duration: 0.25s; }

#vs-page .partner-results .scroll-list::after, #vs-page .partner-results .scroll-list::before { content: ""; height: 100%; pointer-events: none; position: absolute; top: 0px; z-index: 1; }

#vs-page .partner-results .scroll-list::before { background: linear-gradient(90deg, rgb(245, 245, 247), rgba(245, 245, 247, 0)); left: 0px; }

#vs-page .partner-results .scroll-list::after { background: linear-gradient(90deg, rgba(245, 245, 247, 0), rgb(245, 245, 247)); right: 0px; }

#vs-page .partner-results .scroll-list > button { transition-duration: 0.15s; transition-property: border-color, opacity; transition-timing-function: ease-out; }

#vs-page .partner-results .scroll-list > button .icon svg { transition: stroke 0.15s ease-out; }

#vs-page .partner-results .scroll-list > button[disabled] { pointer-events: none; }

#vs-page .partner-results .scroll-list > button:hover { border-color: rgb(42, 42, 46); }

#vs-page .partner-results .scroll-list > button:active { border-color: rgb(204, 204, 204); opacity: 1; }

#vs-page .partner-results .scroll-list > button:active .icon svg { stroke: rgb(204, 204, 204); }

#vs-page .partner-results .scroll-list .pane ul { user-select: none; }

#vs-page .partner-results .scroll-list .pane ul li a { transition: opacity 0.15s ease-out; }

#vs-page .partner-results .scroll-list .pane ul li a:hover { opacity: 0.5; }

#vs-page .partner-results .scroll-list[data-scroll-perc="0"]::before, #vs-page .partner-results .scroll-list[data-scroll-perc="1"]::after { opacity: 0; }

#vs-page .partner-results .scroll-list[data-loading="1"] .pane ul li a { pointer-events: none; }

#vs-page .partner-results .scroll-list[data-loading="1"] .pane ul li a img { opacity: 0; }

#vs-page .partner-results .byline .more a { transition: opacity 0.15s ease-out; }

#vs-page .partner-results .byline .more a:hover { opacity: 0.5; }

#vs-page .partner-results .byline .more a:active { opacity: 0.25; }

@media (min-width: 890.01px) {
  #vs-page .partner-results:not([data-setup="0"]) .scroll-list[data-overflow="0"] .pane ul { padding-left: 40px; }
}

.taglist a { transition-duration: 0.15s; transition-property: color, background-color, opacity; transition-timing-function: ease-out; }

.taglist a:is(:hover, :focus-visible) { background-color: rgb(0, 0, 0); color: rgb(255, 255, 255); }

.taglist a:active { opacity: 0.33; }

@media (prefers-reduced-motion: reduce) {
  .taglist a { transition: none; }
}

.dropdown.dropdown--next { user-select: none; }

.dropdown.dropdown--next:not([data-open="1"]) .dd_display:hover { border-color: rgb(118, 118, 118); box-shadow: rgba(0, 0, 0, 0.15) 0px 1px 3px 0px; transition-duration: 0.15s; }

.dropdown.dropdown--next:not([data-open="1"]) .dd_display:hover svg { stroke: rgb(42, 42, 46); }

.dropdown.dropdown--next .dd_display .wrap > span.placeholder { transition: color 0.15s, transform 0.15s cubic-bezier(0.215, 0.61, 0.355, 1), opacity 0.15s; }

.dropdown.dropdown--next .dd_display .wrap > span.label small, .dropdown.dropdown--next .dd_values > div ul li { transition: 0.15s; }

.dropdown.dropdown--next .dd_values > div ul li .mark svg { stroke: rgb(70, 39, 232); stroke-dasharray: 50; stroke-dashoffset: 50; transition: stroke 0.15s, stroke-dashoffset 0.15s; }

.dropdown.dropdown--next .dd_values > div ul li[data-active="1"] { background-color: rgba(70, 39, 232, 0.05); color: rgb(70, 39, 232); }

.dropdown.dropdown--next .dd_values > div ul li[data-active="1"] .label .icon svg { stroke: rgb(70, 39, 232); }

