nav[aria-label="Breadcrumbs"] ol[aria-disabled="true"] { pointer-events: none; }

.image-deck .deck-grid > .noresults .module p a { transition: opacity 0.15s ease-out; }

.image-deck .deck-grid > .noresults .module p a:active { opacity: 0.25; }

#vs-page > .loadbar { background-color: rgb(255, 255, 255); display: block; left: 0px; pointer-events: none; position: fixed; top: 0px; width: 100%; z-index: 999; }

#vs-page > .loadbar > div { background-color: rgb(70, 39, 232); height: 2px; transition: width 0.5s cubic-bezier(0.215, 0.61, 0.355, 1); }

