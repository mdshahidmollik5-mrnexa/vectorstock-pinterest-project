  #vs-menu .area-head { height: 90px; padding: 25px 45px; }
  #vs-menu .area-head button.navigation { background-color: rgb(70, 39, 232); border: 1px solid rgb(70, 39, 232); border-radius: 2px; height: 41px; width: 41px; }
  #vs-menu .area-head button.navigation .icon { height: 49px; left: -5px; top: -5px; width: 49px; }
  #vs-menu .area-head button.navigation .icon svg { stroke: rgb(255, 255, 255); }
  #vs-menu .area-head .logo, #vs-menu .area-head button.navigation .icon.close { display: none; }
  #vs-menu .area-head .profile { margin-top: 3px; }
